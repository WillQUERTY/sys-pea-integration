# =====================================================================
# Khemia Backend - Configuración de Entorno (.env)
# =====================================================================
# Copiar a `.env` en la carpeta `backend/` (o en la raíz del repo):
#   cp backend/.env.example backend/.env
# El .env real está en .gitignore: JAMÁS se commitea.
# =====================================================================

# Modo del entorno: development | production
APP_ENV=development
DEBUG=true

# ---------------------------------------------------------------------
# Base de Datos SQL Server
# ---------------------------------------------------------------------
# USE_DATABASE:
#   - false: Modo Local / Memoria pura. El backend carga pea_data.json
#            en memoria C++ de forma instantánea. Ideal para desarrollo
#            frontend/backend sin tener SQL Server encendido.
#   - true:  Conecta a SQL Server y sincroniza con write-through.
# Con APP_ENV=production el backend SE NIEGA A ARRANCAR si USE_DATABASE
# no es true, o si la BD no responde (nada de degradarse a JSON: los
# datos no se arriesgan en silencio).
USE_DATABASE=false

DB_SERVER=127.0.0.1
DB_PORT=1433
DB_NAME=peai
DB_USER=sa
# La clave va SOLO en tu .env. Nunca en el código ni en el historial.
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_CERT=yes
DB_TIMEOUT=3

# Alternativa: connection string completo (tiene prioridad sobre lo anterior)
# DB_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=127.0.0.1,1433;Database=peai;UID=sa;PWD=TU-CLAVE;TrustServerCertificate=yes;

# ---------------------------------------------------------------------
# Rutas de Archivos de Datos (Opcional si usas las rutas por defecto)
# ---------------------------------------------------------------------
# DATA_JSON_PATH=../pea_data.json
# CATALOG_JSON_PATH=../database/catalog_2024.json

# =====================================================================
# BLOQUE DE PRODUCCIÓN (servidor Ubuntu + SQL Server en Docker)
# =====================================================================
# En el servidor, backend/.env debe contener (ajusta host/puerto al
# mapeo real del contenedor: `docker ps` muestra algo como
# 0.0.0.0:1433->1433/tcp):
#
#   APP_ENV=production
#   DEBUG=false
#   USE_DATABASE=true
#   DB_SERVER=127.0.0.1
#   DB_PORT=1433
#   DB_NAME=peai
#   DB_USER=sa
#   DB_PASSWORD=<clave real — rotada, NUNCA la que estuvo en git>
#   DB_DRIVER=ODBC Driver 18 for SQL Server
#   DB_TRUST_CERT=yes
#   DB_TIMEOUT=10
#
# El deploy (deploy.yml) aborta si backend/.env no existe en el servidor.
# =====================================================================
